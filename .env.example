MONGLE_API_KEY=<SHARED_SECRET>

QWEN_BASE_URL=http://localhost:8000/v1
QWEN_MODEL=Qwen/Qwen2.5-7B-Instruct
QWEN_API_KEY=EMPTY

# 단일 엔드포인트 + 멀티 LoRA 서빙 예:
#   vllm serve Qwen/Qwen2.5-7B-Instruct --port 8000 \
#     --enable-lora --lora-modules todo-planner-lora=/path/todo persona-lora=/path/persona
#
# 피처별 어댑터(있으면 지정, 없으면 공유 QWEN_MODEL 로 폴백):
# QWEN_TODO_MODEL=todo-planner-lora
# QWEN_CHARACTER_MODEL=persona-lora
# QWEN_QUEST_MODEL=quest-lora
# 특정 피처만 독립 엔드포인트로 뺄 때만(평소엔 공유 QWEN_BASE_URL 사용):
# QWEN_CHARACTER_BASE_URL=http://persona-host:8001/v1
#
# Ollama 로 띄울 때 예:
#   ollama pull qwen2.5:7b && ollama serve
#   QWEN_BASE_URL=http://localhost:11434/v1
#   QWEN_MODEL=qwen2.5:7b

# SFT 합성에 사용
OPENAI_API_KEY=<OPENAI_API_KEY>

# 캐릭터 이미지 생성용 LoRA 가중치 폴더 (character 엔드포인트 필수)
LORA_DIR=<PATH_TO_LORA_WEIGHTS>

# Storage
STORAGE_BACKEND=local
LOCAL_STORAGE_ROOT=

# S3(STORAGE_BACKEND=S3)
AWS_REGION=ap-northeast-2
AWS_S3_BUCKET=<BUCKET>
AWS_S3_PREFIX=mongle-village
AWS_ACCESS_KEY_ID=<AWS_ACCESS_KEY_ID>
AWS_SECRET_ACCESS_KEY=<AWS_SECRET_ACCESS_KEY>

# HuggingFace (모델/어댑터 다운로드·서빙 시 필요)
HF_TOKEN=<HUGGINGFACE_TOKEN>

# SFT 파이프라인 전용
LLM_BASE_URL=http://localhost:11434/v1
# OPENAI_BASE_URL=http://localhost:11434/v1

# DEBUG 로그, OFF=0
MONGLE_DEBUG_TODO=1
MONGLE_DEBUG_CHARACTER=1
