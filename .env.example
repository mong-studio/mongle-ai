## FastAPI ↔ Django 서비스 간 인증 (필수)
MONGLE_API_KEY=<SHARED_SECRET>

## LoRA 가중치 폴더 (character 엔드포인트 필수)
LORA_DIR=<PATH_TO_LORA_WEIGHTS>

## Storage (S3 사용 시)
AWS_REGION=ap-northeast-2
AWS_S3_BUCKET=<BUCKET>
AWS_S3_PREFIX=mongle-village

## OpenAI (이미지 생성 / VLM 등에 여전히 필요)
OPENAI_API_KEY=<OPENAI_API_KEY>

# Ollama 사용 시:
#   $ ollama pull qwen2.5:7b
#   $ ollama serve
QWEN_BASE_URL=http://localhost:11434/v1
QWEN_MODEL=qwen2.5:7b
QWEN_API_KEY=EMPTY

# 또는 vLLM:
#   $ vllm serve Qwen/Qwen2.5-7B-Instruct --port 8000
#   QWEN_BASE_URL=http://localhost:8000/v1
#   QWEN_MODEL=Qwen/Qwen2.5-7B-Instruct

# 생성 이미지 저장 위치(기본: 로컬 저장)
STORAGE_BACKEND=local
LOCAL_STORAGE_ROOT=

# 캐릭터 이미지 생성용 LoRA 가중치 폴더
LORA_DIR=

# SFT 파이프라인(sft_pipeline) 합성·리프레이즈용 로컬 LLM 서버.
# OPENAI_BASE_URL도 폴백으로 인식됩니다.
LLM_BASE_URL=http://localhost:11434/v1

# 디버그 로그를 끄려면 0으로 바꾸세요.
MONGLE_DEBUG_TODO=1
MONGLE_DEBUG_CHARACTER=1


