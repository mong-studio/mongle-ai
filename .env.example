## FastAPI ↔ Django 서비스 간 인증 (필수)
MONGLE_API_KEY=<SHARED_SECRET>

## OpenAI (LLM_PROVIDER=openai 일 때 + VLM 등, 필수)
OPENAI_API_KEY=<OPENAI_API_KEY>

## 메인 LLM 프로바이더: openai | midm (기본 openai)
## midm = OpenAI 호환 엔드포인트(Qwen 등)를 가리키는 변수명. 값에 Qwen 서빙 주소를 넣는다.
LLM_PROVIDER=openai

# Ollama 로 Qwen2.5-7B 띄울 때:
#   $ ollama pull qwen2.5:7b
#   $ ollama serve   # 기본 11434 포트
MIDM_BASE_URL=http://localhost:11434/v1
MIDM_MODEL=qwen2.5:7b
MIDM_API_KEY=EMPTY

# 또는 vLLM (RunPod Serverless 포함):
#   MIDM_BASE_URL=https://api.runpod.ai/v2/<ENDPOINT_ID>/openai/v1
#   MIDM_MODEL=<HF_REPO_ID>
#   MIDM_API_KEY=<RUNPOD_API_KEY>

## 퀘스트 생성 프로바이더: fake | midm (기본 fake — 외부 호출 없이 화면 확인용)
QUEST_LLM_PROVIDER=fake

## Storage 백엔드: local | s3 (기본 local)
STORAGE_BACKEND=local
LOCAL_STORAGE_ROOT=

# STORAGE_BACKEND=s3 일 때 필요:
#   AWS_REGION=<REGION>
#   AWS_S3_BUCKET=<BUCKET>
#   AWS_S3_PREFIX=mongle-village

## 캐릭터 이미지 생성: local | runpod (기본 local)
IMAGE_PROVIDER=local

# IMAGE_PROVIDER=local 일 때 — LoRA 가중치 폴더 (필수)
LORA_DIR=<PATH_TO_LORA_WEIGHTS>

# IMAGE_PROVIDER=runpod 일 때 — RunPod Serverless 워커 (필수)
#   RUNPOD_IMAGE_ENDPOINT_URL=https://api.runpod.ai/v2/<ENDPOINT_ID>
#   RUNPOD_API_KEY=<RUNPOD_API_KEY>

## 디버그 로그를 끄려면 0으로 바꾸세요.
MONGLE_DEBUG_TODO=1
MONGLE_DEBUG_CHARACTER=1
