# ────────────────────────────────────────
# 서비스 간 인증
# mongle-server 의 MONGLE_AI_API_KEY 와 동일값이어야 합니다.
# ────────────────────────────────────────
MONGLE_API_KEY=replace-with-shared-secret

# ────────────────────────────────────────
# LLM 프로바이더
# LLM_PROVIDER: qwen | runpod
# QUEST_LLM_PROVIDER: qwen | runpod
# IMAGE_PROVIDER: local | runpod
# ────────────────────────────────────────
IMAGE_PROVIDER=runpod
LLM_PROVIDER=runpod
QUEST_LLM_PROVIDER=runpod

# ────────────────────────────────────────
# RunPod (LLM_PROVIDER=runpod 또는 IMAGE_PROVIDER=runpod 일 때 필요)
# ────────────────────────────────────────
RUNPOD_API_KEY=
RUNPOD_PLANNER_ENDPOINT_URL=https://api.runpod.ai/v2/<PLANNER_ENDPOINT_ID>
RUNPOD_CHARACTER_ENDPOINT_URL=https://api.runpod.ai/v2/<CHARACTER_ENDPOINT_ID>
RUNPOD_IMAGE_ENDPOINT_URL=https://api.runpod.ai/v2/<IMAGE_ENDPOINT_ID>

# ────────────────────────────────────────
# Qwen / Ollama (LLM_PROVIDER=qwen 또는 QUEST_LLM_PROVIDER=qwen 일 때)
# $ ollama pull qwen2.5:7b && ollama serve
# ────────────────────────────────────────
# QWEN_BASE_URL=http://localhost:11434/v1
# QWEN_MODEL=qwen2.5:7b
# QWEN_API_KEY=EMPTY
# QWEN_PERSONA_MODEL=   # 미설정 시 QWEN_MODEL 폴백

# ────────────────────────────────────────
# 스토리지
# STORAGE_BACKEND / STORAGE: local | s3
# ────────────────────────────────────────
STORAGE_BACKEND=s3
STORAGE=s3

# STORAGE_BACKEND=s3 일 때
AWS_REGION=
AWS_S3_BUCKET=
AWS_S3_PREFIX=mongle-village

# STORAGE_BACKEND=local 일 때
# LOCAL_STORAGE_ROOT=   # 미설정 시 data/local_storage 사용

# ────────────────────────────────────────
# 디버그 로그 (끄려면 0)
# ────────────────────────────────────────
MONGLE_DEBUG_TODO=1
MONGLE_DEBUG_CHARACTER=1
