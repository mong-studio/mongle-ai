# FastAPI ↔ Django 서비스 간 인증 (필수)
MONGLE_API_KEY=<SHARED_SECRET>

# qwen | runpod
LLM_PROVIDER=runpod

# 퀘스트 생성 LLM: fake | qwen | runpod  (fake = 외부 호출 없이 로컬 확인용)
QUEST_LLM_PROVIDER=runpod

# LLM_PROVIDER=runpod 또는 IMAGE_PROVIDER=runpod 일 때 필요
RUNPOD_API_KEY=<RUNPOD_API_KEY>

# 플래너 워커 — bigmooon/qwen2.5-7b-mongle-planner-ko-lora  (todo · quest)
RUNPOD_PLANNER_ENDPOINT_URL=https://api.runpod.ai/v2/<PLANNER_ENDPOINT_ID>

# 빌리지 워커 — deeps1eep/qwen2.5-7b-mongle-village  (character 페르소나)
RUNPOD_VILLAGE_ENDPOINT_URL=https://api.runpod.ai/v2/<VILLAGE_ENDPOINT_ID>

# 이미지 워커 — Hadimeeee/pixel-art-lora-sdxl  (character 픽셀아트 이미지)
RUNPOD_IMAGE_ENDPOINT_URL=https://api.runpod.ai/v2/<IMAGE_ENDPOINT_ID>

# local | runpod
IMAGE_PROVIDER=runpod

# IMAGE_PROVIDER=local 일 때 - 로컬 LoRA 가중치 폴더 경로 (필수)
# LORA_DIR=<PATH_TO_LORA_WEIGHTS>

## ── Qwen / Ollama (LLM_PROVIDER=qwen 또는 QUEST_LLM_PROVIDER=qwen 일 때) ──
# 로컬 Ollama 예시:
#   $ ollama pull qwen2.5:7b && ollama serve
# QWEN_BASE_URL=http://localhost:11434/v1
# QWEN_MODEL=qwen2.5:7b
# QWEN_API_KEY=EMPTY
# # persona 어댑터를 따로 서빙할 때만 지정. 미설정 시 QWEN_MODEL 폴백.
# QWEN_PERSONA_MODEL=

# 스토리지 local | s3
STORAGE_BACKEND=s3

# STORAGE_BACKEND=s3 일 때
AWS_REGION=<REGION>
AWS_S3_BUCKET=<BUCKET>
AWS_S3_PREFIX=mongle-village

# STORAGE_BACKEND=local 일 때 (기본: data/local_storage)
# LOCAL_STORAGE_ROOT=

# SFT용 파이프라인
LLM_BASE_URL=http://localhost:11434/v1

# 디버그 로그를 끄려면 0으로 바꾸세요
MONGLE_DEBUG_TODO=1
MONGLE_DEBUG_CHARACTER=1
