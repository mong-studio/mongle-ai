## Storage (S3 사용 시)
AWS_REGION=<REGION>
AWS_S3_BUCKET=<BUCKET>
AWS_S3_PREFIX=mongle-village

## OpenAI (이미지 생성 / VLM 등에 여전히 필요)
OPENAI_API_KEY=<OPENAI_API_KEY>

## LLM Provider 토글
# todo + character: openai | midm
LLM_PROVIDER=midm
# quest: fake | midm
QUEST_LLM_PROVIDER=midm

## OpenAI 호환 로컬 LLM (Qwen 7B 등)
# 추천: Ollama 로 Qwen2.5-7B-Instruct 띄우기
#   $ ollama pull qwen2.5:7b
#   $ ollama serve   # 기본 11434 포트
MIDM_BASE_URL=http://localhost:11434/v1
MIDM_MODEL=qwen2.5:7b
MIDM_API_KEY=EMPTY

# 또는 vLLM:
#   $ vllm serve Qwen/Qwen2.5-7B-Instruct --port 8000
#   MIDM_BASE_URL=http://localhost:8000/v1
#   MIDM_MODEL=Qwen/Qwen2.5-7B-Instruct
