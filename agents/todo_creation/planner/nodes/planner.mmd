---
config:
  layout: fixed
---
flowchart TB
    START(["planner_node(state, config)"])
    PORTS["get_ports(config).llm"]

    REV{"revision_request 있고\n기존 plan 있음?"}
    REV_BUILD["revision_goal 구성\n- 기존 parsed_goal 복사\n- revision_request 추가\n- previous_plan 추가\n- user_profile_memory 추가"]
    REV_CMD["_plan_command(\nparsed_goal=revision_goal,\nsufficient=true,\nmissing=[]\n)"]

    FU_COUNT{"_follow_up_count(history) >= 2?"}
    RECOVERY["build_recovery_goal(state)"]
    RECOVERY_CMD["_plan_command(\nparsed_goal=recovery_goal,\nsufficient=true,\nmissing=[]\n)"]

    JUDGE["_judge_sufficiency(\nllm,\nhistory,\nmessage,\ntoday,\nuser_profile_memory\n)"]
    JUDGE_SIG{"llm.judge_sufficiency가\nuser_profile_memory 또는 **kwargs 수용?"}
    JUDGE_CALL["await llm.judge_sufficiency(**kwargs)"]
    JUDGE_RESULT["sufficient, missing, parsed"]

    OOS_REJECT{"parsed.intent == out_of_scope\n그리고 should_accept_out_of_scope(state) == false?"}
    OOS_RECOVERY["parsed = build_recovery_goal(state)\nsufficient = true\nmissing = []"]

    OOS{"parsed.intent == out_of_scope?"}
    OOS_CMD["Command goto=out_of_scope\nupdate:\n- sufficiency=false\n- missing_aspects=[]\n- parsed_goal=parsed.copy()"]

    HAS_PARSED{"parsed 있음?"}
    RESOLVE["resolved_goal = parsed.copy()"]
    MERGE["merge_deadline_from_state(state, resolved_goal)"]
    DEADLINE_IN_MISSING{"resolved_goal.deadline 있고\nmissing에 deadline 있음?"}
    REMOVE_DEADLINE["missing에서 deadline 제거\nmissing 비면 sufficient=true"]
    ADD_MEMORY["resolved_goal.user_profile_memory =\nstate.user_profile_memory or {}"]
    NO_PARSED["resolved_goal = null"]

    DELEGATES{"delegates_planning(message)\n그리고 resolved_goal 있음?"}
    FORCE_SUFFICIENT["sufficient = true\nmissing = []"]

    DEADLINE_FU{"sufficient 이고\nneeds_deadline_follow_up(state, resolved_goal)?"}
    DEADLINE_CMD["Command goto=follow_up\nupdate:\n- sufficiency=false\n- missing_aspects=[deadline]\n- parsed_goal=resolved_goal"]

    FINAL_CMD["Command\n goto = sufficient ? plan_generator : follow_up\nupdate:\n- sufficiency=bool(sufficient)\n- missing_aspects=list(missing or [])\n- parsed_goal=resolved_goal"]

    PLAN_GENERATOR(["plan_generator"])
    FOLLOW_UP(["follow_up"])
    OUT_OF_SCOPE(["out_of_scope"])

    START --> PORTS --> REV
    REV -- yes --> REV_BUILD --> REV_CMD
    REV -- no --> FU_COUNT
    REV_CMD --> PLAN_GENERATOR

    FU_COUNT -- yes --> RECOVERY --> RECOVERY_CMD --> PLAN_GENERATOR
    FU_COUNT -- no --> JUDGE

    JUDGE -. 내부 .-> JUDGE_SIG
    JUDGE_SIG -- yes --> JUDGE_CALL
    JUDGE_SIG -- no --> JUDGE_CALL
    JUDGE_CALL --> JUDGE_RESULT
    JUDGE_RESULT --> OOS_REJECT

    OOS_REJECT -- yes --> OOS_RECOVERY --> OOS
    OOS_REJECT -- no --> OOS

    OOS -- yes --> OOS_CMD --> OUT_OF_SCOPE
    OOS -- no --> HAS_PARSED

    HAS_PARSED -- yes --> RESOLVE --> MERGE --> DEADLINE_IN_MISSING
    DEADLINE_IN_MISSING -- yes --> REMOVE_DEADLINE --> ADD_MEMORY
    DEADLINE_IN_MISSING -- no --> ADD_MEMORY
    HAS_PARSED -- no --> NO_PARSED

    ADD_MEMORY --> DELEGATES
    NO_PARSED --> DELEGATES
    DELEGATES -- yes --> FORCE_SUFFICIENT --> DEADLINE_FU
    DELEGATES -- no --> DEADLINE_FU

    DEADLINE_FU -- yes --> DEADLINE_CMD --> FOLLOW_UP
    DEADLINE_FU -- no --> FINAL_CMD
    FINAL_CMD -- sufficient --> PLAN_GENERATOR
    FINAL_CMD -- insufficient --> FOLLOW_UP

    classDef entry fill:#fef9c3,stroke:#ca8a04,color:#713f12
    classDef decision fill:#fed7aa,stroke:#ea580c,color:#7c2d12
    classDef process fill:#ffffff,stroke:#6b7280,color:#111827
    classDef helper fill:#f5f3ff,stroke:#7c3aed,color:#4c1d95
    classDef command fill:#dcfce7,stroke:#16a34a,color:#14532d
    classDef target fill:#bae6fd,stroke:#0284c7,color:#0c4a6e

    class START,PLAN_GENERATOR,FOLLOW_UP,OUT_OF_SCOPE entry
    class REV,FU_COUNT,JUDGE_SIG,OOS_REJECT,OOS,HAS_PARSED,DEADLINE_IN_MISSING,DELEGATES,DEADLINE_FU decision
    class PORTS,REV_BUILD,RECOVERY,OOS_RECOVERY,RESOLVE,MERGE,REMOVE_DEADLINE,ADD_MEMORY,NO_PARSED,FORCE_SUFFICIENT process
    class JUDGE,JUDGE_CALL,JUDGE_RESULT helper
    class REV_CMD,RECOVERY_CMD,OOS_CMD,DEADLINE_CMD,FINAL_CMD command
    class PLAN_GENERATOR,FOLLOW_UP,OUT_OF_SCOPE target
