sft_pipeline/data/seeds/*
!sft_pipeline/data/seeds/planner_runtime_gold.jsonl
!sft_pipeline/experiments/
sft_pipeline/experiments/*
!sft_pipeline/experiments/__init__.py
!sft_pipeline/experiments/planner_runtime_v2/
!sft_pipeline/experiments/planner_runtime_v2/**

# Model outputs (large binary files)
outputs/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.coverage
.coverage.*
htmlcov/

# Virtualenv
.venv/
venv/

# Environment
.env
.env.local
.env.*.local

# OS
.DS_Store

# IDE
.idea/
.vscode/

# Local tool state
.omc/
.reports/
.ruff_cache/
.claude/

