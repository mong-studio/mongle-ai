    classDef gate fill:#fed7aa,stroke:#ea580c,color:#7c2d12
    classDef worker fill:#ecfeff,stroke:#0891b2,color:#164e63

    A:::input
    OUT:::input
    CTX1:::ai
    FEED:::ai
    S3:::process
    CTX2:::process
    LLM:::ai
    BUILD:::process
    W1:::worker
